{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":BUN:",
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":PACKAGE_WITH_PROTOCOL:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        "useSortedAttributes": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    },
    "enabled": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules/*",
      "!**/*.config.*",
      "!**/.turbo",
      "!**/dist",
      "!**/out",
      "!**/.next",
      "!**/public/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "lineEnding": "lf",
    "lineWidth": 120
  },
  "linter": {
    "domains": {
      "next": "all",
      "react": "all",
      "test": "all"
    },
    "enabled": true,
    "rules": {
      "complexity": {},
      "correctness": {
        "noNodejsModules": "off",
        "useImportExtensions": "off",
        "useUniqueElementIds": "off"
      },
      "recommended": true,
      "performance": {
        // newly enabled by the "react": "all" domain in Biome 2.5 — 92 pre-existing hits repo-wide;
        // tracked as follow-up cleanup, see CLAUDE.md QA report, not fixed as part of a dependency bump
        "noJsxPropsBind": "off"
      },
      "style": {
        "noDefaultExport": "off",
        "noImplicitBoolean": "off",
        "useNamingConvention": "off"
      },
      "suspicious": {
        // newly enabled by the "react": "all" domain in Biome 2.5 — pre-existing hits repo-wide;
        // tracked as follow-up cleanup, see CLAUDE.md QA report, not fixed as part of a dependency bump
        "noConsole": "off",
        "noLeakedRender": "off",
        "noReactSpecificProps": "off",
        "noUnknownAtRules": "off"
      }
    }
  }
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true,
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@nfl-pool-monorepo/api/*": ["../../packages/api/*"],
      "@nfl-pool-monorepo/db/*": ["../../packages/db/*"],
      "@nfl-pool-monorepo/transactional/*": ["../../packages/transactional/*"],
      "@nfl-pool-monorepo/types": ["../../packages/types/index.ts"],
      "@nfl-pool-monorepo/utils/*": ["../../packages/utils/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "extends": "./base.json"
}

  "main": "index.js",
  "name": "nfl-pool-monorepo",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "private": true,
  "repository": "",
  "scripts": {
    "add-shadcn-component": "turbo run add-shadcn-component -- --",
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "env": "turbo env",
    "fallow": "fallow audit --dead-code-baseline .fallow-dead-code-baseline.json",
    "format": "turbo format --continue --",
    "format:fix": "turbo format --continue -- --write",
    "freerange": "turbo freerange --continue",
    "knip": "turbo knip",
    "lint": "turbo lint --continue --",
    "lint:fix": "turbo lint --continue -- --apply",
    "lint:package": "npmPkgJsonLint .",
    "prepare": "husky",
    "prepush": "turbo knip lint typecheck test freerange --log-order stream --parallel && fallow audit --dead-code-baseline .fallow-dead-code-baseline.json",
    "setup": "typesync && pnpm install",
    "test": "turbo test --continue",
    "typecheck": "turbo typecheck --continue",
    "doctor": "npx react-doctor@latest"
  },
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]

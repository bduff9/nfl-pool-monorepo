  "description": "NFL Pool Monorepo.",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "fallow": "3.33.1",
    "husky": "9.1.7",
    "npm-package-json-lint": "11.0.0",
    "react-doctor": "^0.9.17",
    "typescript": "7.0.2",
    "typesync": "0.14.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "homepage": "",
  "keywords": [],

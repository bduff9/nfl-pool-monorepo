{
  "entry": [
    "packages/transactional/emails/templates/*.tsx",
    // The service worker is bundled and served by src/app/serwist/[path]/route.ts, which names it by path string
    "apps/web/src/sw.ts",
    // Spawned by path from next.config.ts (compiler.runAfterProductionCompile) to upload source maps after the build
    "apps/web/scripts/upload-sourcemaps.mjs",
    // Run by hand to regenerate public/splash/*.png, the iOS launch screens
    "apps/web/scripts/generate-splash-screens.mjs",
    // Run by hand to regenerate public/icon-monochrome-512x512.png, the Android themed launcher icon
    "apps/web/scripts/generate-monochrome-icon.mjs"
  ],
  "ignoreDependencies": ["shadcn", "react-doctor", "jiti", "nypm", "postcss-load-config"],
  "ignoreExports": [
    // @serwist/turbopack's route handler re-exports generateStaticParams, which Next consumes but fallow's Next plugin
    // only recognises on pages
    {
      "exports": ["generateStaticParams"],
      "file": "apps/web/src/app/serwist/*/route.ts"
    }
  ]
}
